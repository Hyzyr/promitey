'use client';

import { Download, ExternalLink } from 'lucide-react';
import { useTranslations } from 'next-intl';
import { useState } from 'react';

import { cn } from '@/lib/utils';

type Protocol = 'openvpn' | 'vless';

const protocols: Protocol[] = ['openvpn', 'vless'];

const protocolActions: Record<Protocol, { href: string; icon: typeof Download }> = {
  openvpn: { href: '/api/configs/openvpn', icon: Download },
  vless: { href: '/api/configs/vless', icon: ExternalLink },
};

export const InstructionsTabs = () => {
  const t = useTranslations('dashboard.instructions');
  const [activeProtocol, setActiveProtocol] = useState<Protocol>('openvpn');

  const action = protocolActions[activeProtocol];
  const ActionIcon = action.icon;

  return (
    <section className="w-full max-w-212.5 rounded-md bg-white px-5 py-5 shadow-[0_13px_51.2px_rgba(0,0,0,.04)]">
      <div
        role="tablist"
        aria-label={t('tabs.ariaLabel')}
        className="grid grid-cols-2 gap-2 rounded-md bg-neutral-30 p-1"
      >
        {protocols.map((protocol) => (
          <button
            key={protocol}
            id={`${protocol}-tab`}
            type="button"
            role="tab"
            aria-selected={activeProtocol === protocol}
            aria-controls={`${protocol}-panel`}
            onClick={() => setActiveProtocol(protocol)}
            className={cn(
              'rounded-sm px-4 py-3 text-sm font-bold transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 md:text-base',
              activeProtocol === protocol
                ? 'bg-white text-neutral-900 shadow-[0_8px_28px_rgba(0,0,0,.06)]'
                : 'text-neutral-500 hover:text-neutral-800',
            )}
          >
            {t(`tabs.${protocol}`)}
          </button>
        ))}
      </div>

      <div
        id={`${activeProtocol}-panel`}
        role="tabpanel"
        aria-labelledby={`${activeProtocol}-tab`}
        className="pt-6"
      >
        <div className="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
          <div className="max-w-130">
            <p className="text-sm font-bold uppercase tracking-[0.08em] text-primary-600">
              {t(`protocols.${activeProtocol}.eyebrow`)}
            </p>
            <h2 className="mt-2 text-[24px] font-bold leading-tight text-neutral-900 md:text-[28px]">
              {t(`protocols.${activeProtocol}.title`)}
            </h2>
            <p className="mt-3 text-base leading-relaxed text-neutral-600">
              {t(`protocols.${activeProtocol}.description`)}
            </p>
          </div>

          <a
            href={action.href}
            className="inline-flex items-center justify-center gap-2 rounded-md bg-primary-500 px-5 py-3 font-manrope text-[18px] font-semibold text-neutral-900 transition hover:bg-primary-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 active:scale-[0.97]"
          >
            <ActionIcon className="h-5 w-5" />
            {t(`protocols.${activeProtocol}.action`)}
          </a>
        </div>

        <ol className="mt-7 grid gap-3 md:grid-cols-3">
          {[0, 1, 2].map((stepIndex) => (
            <li
              key={stepIndex}
              className="rounded-md border border-neutral-30 bg-neutral-20 p-4"
            >
              <span className="flex h-8 w-8 items-center justify-center rounded-full bg-neutral-900 text-sm font-bold text-white">
                {stepIndex + 1}
              </span>
              <h3 className="mt-4 text-base font-bold text-neutral-900">
                {t(`protocols.${activeProtocol}.steps.${stepIndex}.title`)}
              </h3>
              <p className="mt-2 text-sm leading-relaxed text-neutral-600">
                {t(`protocols.${activeProtocol}.steps.${stepIndex}.body`)}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  );
};
