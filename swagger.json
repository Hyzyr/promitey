{
  "swagger": "2.0",
  "info": {
    "title": "VPN Bot HTTP API",
    "description": "API сайта: регистрация, сброс/смена пароля (письма на почту пока только логируются), привязка Telegram ↔ аккаунт сайта. OpenVPN/VLESS — при привязанном Telegram и активной подписке в текущей модели (та же БД, что у бота).",
    "version": "1.0.0"
  },
  "basePath": "/api/v1",
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Формат: Bearer <access_token> (выдаётся в POST /auth/login и /auth/refresh)"
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Регистрация, JWT, пароль"
    },
    {
      "name": "account",
      "description": "Профиль и привязка Telegram"
    },
    {
      "name": "vpn",
      "description": "Регион, конфиги VPN (нужны привязка Telegram и активная подписка там, где указано)"
    },
    {
      "name": "billing",
      "description": "Оплата подписки через WATA"
    }
  ],
  "paths": {
    "/auth/register": {
      "put": {
        "tags": [
          "auth"
        ],
        "summary": "Подготовить регистрацию",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RegisterRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Требуется код подтверждения",
            "schema": {
              "$ref": "#/definitions/VerificationRequired"
            }
          },
          "400": {
            "description": "Невалидные данные",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "409": {
            "description": "Email уже занят",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      },
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Подтвердить регистрацию",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RegisterConfirmRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Создано",
            "schema": {
              "$ref": "#/definitions/StatusOK"
            }
          },
          "400": {
            "description": "Неверный код или нет pending регистрации",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "409": {
            "description": "Email уже занят",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Вход",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LoginRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Токены (Bearer), либо при включённом TOTP — объект TotpChallenge (см. схему LoginSuccess)",
            "schema": {
              "$ref": "#/definitions/LoginSuccess"
            }
          },
          "401": {
            "description": "Неверные учётные данные",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/auth/login/totp": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Второй шаг входа (код из приложения-аутентификатора)",
        "description": "После POST /auth/login, если включён TOTP, приходит temp_token; сюда передаётся код.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LoginTotpRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Токены",
            "schema": {
              "$ref": "#/definitions/TokenPair"
            }
          },
          "401": {
            "description": "Неверный temp_token или код",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Обновление пары токенов",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RefreshRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Новые токены",
            "schema": {
              "$ref": "#/definitions/TokenPair"
            }
          },
          "401": {
            "description": "Невалидный refresh",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Запросить код для сброса пароля",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ForgotPasswordRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Требуется код подтверждения",
            "schema": {
              "$ref": "#/definitions/VerificationRequired"
            }
          },
          "400": {
            "description": "Невалидные данные",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Сбросить пароль по коду",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ResetPasswordRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Пароль обновлён",
            "schema": {
              "$ref": "#/definitions/StatusOK"
            }
          },
          "400": {
            "description": "Невалидные данные или код",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/auth/email": {
      "put": {
        "tags": [
          "auth"
        ],
        "summary": "Подготовить смену email",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ChangeEmailPrepareRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Требуется код подтверждения",
            "schema": {
              "$ref": "#/definitions/VerificationRequired"
            }
          },
          "400": {
            "description": "Невалидные данные",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      },
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Подтвердить смену email",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ChangeEmailConfirmRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ок",
            "schema": {
              "$ref": "#/definitions/StatusOK"
            }
          },
          "400": {
            "description": "Невалидный код или нет pending запроса",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/auth/password": {
      "put": {
        "tags": [
          "auth"
        ],
        "summary": "Сменить пароль (в сессии)",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ChangePasswordRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ок",
            "schema": {
              "$ref": "#/definitions/StatusOK"
            }
          },
          "400": {
            "description": "Невалидные данные",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "401": {
            "description": "Неверный текущий пароль или нет Bearer",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/auth/totp/setup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Начать привязку TOTP (Google Authenticator и т.п.)",
        "description": "Сохраняет ожидающий секрет; далее POST /auth/totp/enable с кодом из приложения.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "otpauth URL для QR",
            "schema": {
              "$ref": "#/definitions/TotpSetupResponse"
            }
          },
          "400": {
            "description": "TOTP уже включён",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "401": {
            "description": "Не авторизован",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/auth/totp/enable": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Подтвердить и включить TOTP",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TotpEnableRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "TOTP включён",
            "schema": {
              "$ref": "#/definitions/TotpStatusResponse"
            }
          },
          "400": {
            "description": "Нет pending setup / уже включён",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "401": {
            "description": "Неверный код",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/auth/totp/disable": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Отключить TOTP",
        "description": "Нужны пароль и текущий одноразовый код.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TotpDisableRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "TOTP отключён",
            "schema": {
              "$ref": "#/definitions/TotpStatusResponse"
            }
          },
          "400": {
            "description": "TOTP не был включён",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "401": {
            "description": "Неверный пароль или код",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "Текущий пользователь",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Профиль",
            "schema": {
              "$ref": "#/definitions/MeResponse"
            }
          },
          "401": {
            "description": "Нет/просрочен токен",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "404": {
            "description": "Аккаунт не найден",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/link/site-token": {
      "post": {
        "tags": [
          "account"
        ],
        "summary": "Токен привязки сайт → Telegram",
        "description": "Одноразовый токен (~15 мин) и deep_link вида https://t.me/Bot?start=link_<token>. Открыть в Telegram, бот привяжет web_accounts к telegram_id.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Токен выдан",
            "schema": {
              "$ref": "#/definitions/SiteLinkTokenResponse"
            }
          },
          "400": {
            "description": "Уже привязан и т.п.",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "401": {
            "description": "Не авторизован",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/vpn/region": {
      "get": {
        "tags": [
          "vpn"
        ],
        "summary": "Текущий регион OpenVPN",
        "description": "Нужны Bearer и привязанный Telegram. Подписка не обязательна для чтения.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Регион",
            "schema": {
              "$ref": "#/definitions/RegionResponse"
            }
          },
          "403": {
            "description": "Telegram не привязан / бан",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "401": {
            "description": "Не авторизован",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/vpn/openvpn/config": {
      "get": {
        "tags": [
          "vpn"
        ],
        "summary": "Скачать OpenVPN .ovpn",
        "description": "Bearer + привязанный Telegram + **активная подписка**. Ответ: бинарное тело файла, Content-Type application/x-openvpn-profile.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "produces": [
          "application/x-openvpn-profile"
        ],
        "responses": {
          "200": {
            "description": "Файл конфигурации"
          },
          "403": {
            "description": "Нет подписки / не привязан Telegram",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "401": {
            "description": "Не авторизован",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "500": {
            "description": "Ошибка генерации",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/vpn/openvpn/config/{region}": {
      "get": {
        "tags": [
          "vpn"
        ],
        "summary": "Скачать OpenVPN .ovpn и сохранить регион",
        "security": [
          {
            "Bearer": []
          }
        ],
        "produces": [
          "application/x-openvpn-profile"
        ],
        "parameters": [
          {
            "name": "region",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Файл конфигурации"
          },
          "403": {
            "description": "Нет подписки",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "401": {
            "description": "Не авторизован",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        },
        "description": "Скачать OpenVPN-конфиг c выбором региона. Допустимые country codes: auto, fr, uk, pl, us, iq, ru, de, nl."
      }
    },
    "/promocode/activate": {
      "post": {
        "tags": [
          "billing"
        ],
        "summary": "Активировать промокод",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PromocodeActivateRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Промокод активирован",
            "schema": {
              "$ref": "#/definitions/PromocodeActivateResponse"
            }
          },
          "400": {
            "description": "Ошибка валидации или код истек",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "404": {
            "description": "Код не найден",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "409": {
            "description": "Пробный код уже использован",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/vpn/vless/subscription": {
      "get": {
        "tags": [
          "vpn"
        ],
        "summary": "VLESS subscription URL (Marzban)",
        "description": "Bearer + привязанный Telegram + **активная подписка**. На сервере должен быть настроен Marzban.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Ссылка",
            "schema": {
              "$ref": "#/definitions/VLESSSubscriptionResponse"
            }
          },
          "403": {
            "description": "Нет подписки",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "503": {
            "description": "Marzban не настроен",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "401": {
            "description": "Не авторизован",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/vpn/recreate": {
      "post": {
        "tags": [
          "vpn"
        ],
        "summary": "Перевыпуск OpenVPN + VLESS",
        "description": "Тот же сценарий, что «пересоздать конфиг» в боте. Rate limit ~2 мин на аккаунт. Тело опционально: {\"region\":\"...\"}.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/RecreateRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ок",
            "schema": {
              "$ref": "#/definitions/StatusOK"
            }
          },
          "429": {
            "description": "Слишком часто",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "403": {
            "description": "Нет подписки",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "401": {
            "description": "Не авторизован",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/billing/checkout": {
      "post": {
        "tags": [
          "billing"
        ],
        "summary": "Создать платёжную ссылку WATA",
        "description": "Создаёт разовую платёжную ссылку WATA (OneTime) для выбранного тарифа. Требуется привязанный Telegram (или standalone web user). Успешная оплата активирует/продлевает VPN через webhook `/webhooks/wata`. Повторная оплата — новый checkout.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BillingCheckoutRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Платёжная ссылка создана",
            "schema": {
              "$ref": "#/definitions/BillingCheckoutResponse"
            }
          },
          "400": {
            "description": "Неизвестный тариф",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "401": {
            "description": "Не авторизован",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "503": {
            "description": "WATA не настроена (WATA_ACCESS_TOKEN)",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "502": {
            "description": "Ошибка WATA API",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/subscription/current": {
      "get": {
        "summary": "Current active subscription",
        "description": "Проверка текущей активной подписки. Для Tribute-подписок поле end_date возвращается пустой строкой, так как срок управляется Tribute и не хранится как фиксированная дата окончания.",
        "tags": [
          "VPN"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/CurrentSubscriptionResponse"
            }
          },
          "404": {
            "description": "No active subscription"
          }
        }
      }
    },
    "/subscription/manage": {
      "get": {
        "summary": "Управление подпиской",
        "description": "Возвращает детали подписки и доступные действия. WATA — разовые платежи: продление через новый checkout. Отмена WATA/Stars/промо — немедленное завершение и отзыв VPN. Tribute — только в приложении Tribute.",
        "tags": [
          "billing"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/SubscriptionManageResponse"
            }
          },
          "404": {
            "description": "Нет активной подписки",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    },
    "/subscription/cancel": {
      "post": {
        "summary": "Досрочно отменить подписку",
        "description": "Немедленное завершение подписки и отзыв VPN. Не возвращает деньги. Недоступно для Tribute.",
        "tags": [
          "billing"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Подписка отменена",
            "schema": {
              "$ref": "#/definitions/SubscriptionCancelResponse"
            }
          },
          "409": {
            "description": "Отмена недоступна для этого типа подписки",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          },
          "404": {
            "description": "Нет активной подписки",
            "schema": {
              "$ref": "#/definitions/ErrorBody"
            }
          }
        }
      }
    }
  },
