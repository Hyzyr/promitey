# Backend API base URL including the /api/v1 prefix
# Local backend example: http://localhost:8080/api/v1
# Shared dev backend example: https://31232114dfsdf.api.dev.prometey.ink/api/v1
API_BASE_URL=

# Public site URL (used for metadata, sitemap, robots, OG images)
# Example: https://yoursite.com
# Host-only values like yoursite.com are accepted and normalized to https://yoursite.com.
NEXT_PUBLIC_SITE_URL=

# Failed server actions and dashboard SSR errors are forwarded to the browser console in development.
# Set true outside development only when you explicitly need browser-visible diagnostics.
NEXT_PUBLIC_FORWARD_SERVER_ERRORS=false

# Development-only manual auth verification codes used by the current backend fixtures:
# register confirm: 111111
# email change confirm: 999999
# forgot/reset password: 555555
