# Backend API base URL including the /api/v1 prefix
# Example: http://localhost:8080/api/v1
API_BASE_URL=

# Public site URL (used for metadata, sitemap, robots, OG images)
# Example: https://yoursite.com
NEXT_PUBLIC_SITE_URL=

# When true, failed server actions and dashboard SSR errors are forwarded to the browser console.
# Keep disabled in production unless you explicitly need browser-visible diagnostics.
NEXT_PUBLIC_FORWARD_SERVER_ERRORS=false
