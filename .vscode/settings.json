{
  // ── Tailwind CSS v4 (CSS-first config) ──────────────────────────────────
  "tailwindCSS.experimental.configFile": "src/app/globals.css",

  // Teach VS Code's CSS language server about Tailwind v4 at-rules (@theme, @utility, @apply…)
  // This is the proper approach — VS Code understands these natively with docs, not just ignores them
  "css.customData": [".vscode/tailwind-css-data.json"],

  // Exclude docs markdown from Tailwind analysis (stops false lint hints)
  "tailwindCSS.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.hg/**",
    "docs/**"
  ],

  // Treat .css files in the src directory as Tailwind entry points
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },

  // ── TypeScript ────────────────────────────────────────────────────────────
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  
  // Suppress Next.js 16 false positive warnings for client component props
  // These warnings appear in VS Code but don't affect compilation or runtime
  "js/ts.tsserver.experimental.enableProjectDiagnostics": false,

  // ── Editor ────────────────────────────────────────────────────────────────
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" }
}
